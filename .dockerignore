# Keep the build context small and never ship local secrets or dev-only files.
node_modules
npm-debug.log*

# Local secrets / env files (never copy into the image)
.env
.env.*
!.env.example
!.env.docker.example
!.env.test.example

# Tests and coverage (not needed at runtime)
tests
coverage
.nyc_output

# Tooling / editor / VCS
.git
.gitignore
.vscode
.idea
.agents
.claude
.windsurf

# Docker / docs artifacts not needed inside the image
Dockerfile
docker-compose.yml
.dockerignore
README.md
