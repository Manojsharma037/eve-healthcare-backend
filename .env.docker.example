# Example environment for the Docker Compose stack.
#
# Copy to .env.docker and customize, then run:
#   docker compose --env-file .env.docker up --build
#
# Plain `docker compose up --build` also works WITHOUT this file — docker-compose.yml
# has safe non-secret defaults. These variables simply override those defaults.
#
# IMPORTANT: These are the DOCKER stack's OWN credentials. They are unrelated to,
# and never read from, your local development .env. Do NOT commit a real
# .env.docker (it is git-ignored).

# --- PostgreSQL container (also used to build the backend's DATABASE_URL) ---
POSTGRES_USER=eve_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=eve_healthcare

# --- Backend ---
# Namespaced so it never collides with your local .env's JWT_SECRET.
EVE_DOCKER_JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d

# PORT is fixed to 5000 inside docker-compose.yml (mapped to host 5000).
