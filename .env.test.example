# Example environment for the automated test suite.
# Copy the TEST_DATABASE_URL value into your local (git-ignored) .env — or into a
# git-ignored .env.test file — and fill in real credentials. Never commit real values.
#
# This MUST point at the dedicated test database (eve_healthcare_test), NOT the
# development database (eve_healthcare). The Jest setup refuses to run otherwise.

TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eve_healthcare_test?schema=public"
